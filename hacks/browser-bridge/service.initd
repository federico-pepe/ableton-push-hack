#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{SVC_NAME}}
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: push-hack: browser-bridge — install PushHackBrowser remote script
### END INIT INFO

# Deployed by push-hack install.sh — do not edit on device.
# This is an "installer" service: start = copy the Live MIDI Remote Script into
# the User Library; stop = remove it. There is no long-running daemon — the
# socket server runs inside Live (PushHackBrowser.py) once Live loads the script.
#
# Enabling the script in a control-surface slot and restarting Live is a manual,
# user-managed step (same as ClyphX / AbleSet). This service never touches
# Preferences.cfg and never restarts Live.

SCRIPT_SRC="{{HACK_DIR}}/remote-script"
REMOTE_SCRIPTS_DIR="/data/Music/Ableton/User Library/Remote Scripts"
SCRIPT_DST="${REMOTE_SCRIPTS_DIR}/PushHackBrowser"
OWNER="ableton:users"
LOGFILE="{{LOG_DIR}}/browser-bridge.log"

log() {
    echo "$(date '+%Y-%m-%dT%H:%M:%S'): $*" >> "$LOGFILE"
}

start() {
    echo "Starting {{SVC_NAME}}..."
    mkdir -p "$(dirname "$LOGFILE")"
    if [ ! -d "$SCRIPT_SRC" ]; then
        log "ERROR: remote-script payload missing at $SCRIPT_SRC"
        echo "{{SVC_NAME}}: remote-script payload missing"
        return 1
    fi
    mkdir -p "$REMOTE_SCRIPTS_DIR"
    rm -rf "$SCRIPT_DST"
    cp -r "$SCRIPT_SRC" "$SCRIPT_DST"
    # Live runs as the ableton user — it must own the files to load them.
    chown -R "$OWNER" "$SCRIPT_DST"
    log "Installed PushHackBrowser remote script to $SCRIPT_DST"
    echo "{{SVC_NAME}}: installed PushHackBrowser at $SCRIPT_DST"
    echo "  NEXT (manual, one-time): enable \"PushHackBrowser\" in a free"
    echo "  control-surface slot (Input/Output = None) and restart Live."
}

stop() {
    echo "Stopping {{SVC_NAME}}..."
    rm -rf "$SCRIPT_DST"
    log "Removed PushHackBrowser remote script from $SCRIPT_DST"
    echo "{{SVC_NAME}}: removed PushHackBrowser (disable it in Live prefs + restart Live)"
}

status() {
    if [ -d "$SCRIPT_DST" ]; then
        echo "{{SVC_NAME}}: installed at $SCRIPT_DST"
        return 0
    else
        echo "{{SVC_NAME}}: not installed"
        return 1
    fi
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) stop; sleep 1; start ;;
    status)  status  ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
