#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{SVC_NAME}}
# Required-Start:    push3
# Required-Stop:     push3
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: push-hack: inject push_hook.so into Push3 via LD_PRELOAD
### END INIT INFO

# Deployed by push-hack install.sh — do not edit on device
HOOK_SO="{{HACK_DIR}}/push_hook.so"
PUSH3_INITD="/etc/init.d/push3"
LOGFILE="{{LOG_DIR}}/push-display.log"
MARKER="# push-hack: push-display"

log() {
    echo "$(date '+%Y-%m-%dT%H:%M:%S'): $*" >> "$LOGFILE"
}

start() {
    echo "Starting {{SVC_NAME}}..."
    mkdir -p "$(dirname "$LOGFILE")"

    # Pre-create the hook's own log file owned by the Push3 user. Push3 runs as
    # 'ableton'; without this the file is first created by the root
    # start-stop-daemon (root:644) and Push3 can never append to it, so all hook
    # logs spill to syslog. Owning it ableton:users keeps hook logging in its
    # own file.
    HOOK_LOG="{{LOG_DIR}}/push-hook.log"
    touch "$HOOK_LOG"
    chown ableton:users "$HOOK_LOG" 2>/dev/null || true
    chmod 664 "$HOOK_LOG"

    if [ ! -f "$HOOK_SO" ]; then
        echo "ERROR: $HOOK_SO not found"
        exit 1
    fi

    # Idempotent: remove any existing patch first, then re-add cleanly
    sed -i "/$MARKER/d" "$PUSH3_INITD"
    sed -i '/export LD_PRELOAD.*push_hook/d' "$PUSH3_INITD"

    # Insert LD_PRELOAD export before the start-stop-daemon line
    sed -i "/start-stop-daemon/i\\
$MARKER\\
export LD_PRELOAD=$HOOK_SO" "$PUSH3_INITD"

    log "Patched $PUSH3_INITD with LD_PRELOAD=$HOOK_SO"
    echo "Restarting push3 to apply hook..."
    /etc/init.d/push3 stop 2>/dev/null || true
    sleep 2
    /etc/init.d/push3 start
    log "push3 restarted with hook"
    echo "{{SVC_NAME}} started"
}

stop() {
    echo "Stopping {{SVC_NAME}}..."

    # Remove LD_PRELOAD patch
    sed -i "/$MARKER/d" "$PUSH3_INITD"
    sed -i '/export LD_PRELOAD.*push_hook/d' "$PUSH3_INITD"

    log "Removed LD_PRELOAD patch from $PUSH3_INITD"
    echo "Restarting push3 without hook..."
    /etc/init.d/push3 stop 2>/dev/null || true
    sleep 2
    /etc/init.d/push3 start
    log "push3 restarted without hook"
    echo "{{SVC_NAME}} stopped"
}

status() {
    if grep -q "$MARKER" "$PUSH3_INITD" 2>/dev/null; then
        echo "{{SVC_NAME}} is running (LD_PRELOAD active in $PUSH3_INITD)"
        return 0
    else
        echo "{{SVC_NAME}} is stopped (LD_PRELOAD not in $PUSH3_INITD)"
        return 1
    fi
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) stop; start ;;
    status)  status  ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
