# Claude Code local settings
.claude/

# macOS
.DS_Store

# Go (module vendor dirs only — not static web-asset vendor/ dirs like
# hacks/*/src/ui/vendor/)
*.test
hacks/*/src/vendor/

# Build output binaries (deploy via install.sh, never git-tracked — a
# tracked binary here can shadow the depth-1 one that install.sh's
# `find -maxdepth 2` picks up first alphabetically)
hacks/*/build/
hacks/*/push-manager
hacks/*/push-catalog
hacks/*/automation
hacks/*/src/push-manager
hacks/*/src/automation
hacks/*/src/keyboard-visualizer
hacks/push-audio-loopback/push-audio-loopback
hacks/push-audio-loopback/src/push-audio-loopback
hacks/push-braids-host/push-braids-host

# Prebuilt kernel modules (one per Push kernel version, built offline from
# Ableton's GPL source release — see hacks/push-audio-loopback/README.md).
# Large, kernel-specific binaries; not meant to be git-tracked.
hacks/push-audio-loopback/ko/

# Logs
*.log

# Resources
/resources/push-assets/*

# Local-only discovery / research notes (not shipped)
/discovery/

# Apple/Monotype-licensed font, loaded at runtime if present (see
# core/gfx/text/face.go's PUSHAPP_STYLED_FONT_DIR) — not redistributable
# in this public repo, so never track it even if a developer drops a copy
# in the expected assets/ path.
core/gfx/text/assets/*.otf
hacks/push-store/push-store
hacks/random-preset/random-preset
.vscode/PythonImportHelper-v2-Completion.json
