# Claude Code local settings
.claude/

# macOS
.DS_Store

# Go (module vendor dirs only — not static web-asset vendor/ dirs like
# hacks/*/src/ui/vendor/)
*.test
hacks/*/src/vendor/

# Build output binaries (deploy via install.sh, never git-tracked — a
# tracked binary here can shadow the depth-1 one that install.sh's
# `find -maxdepth 2` picks up first alphabetically)
hacks/*/build/
hacks/*/push-manager
hacks/*/automation
hacks/*/keyboard-visualizer
hacks/*/src/push-manager
hacks/*/src/automation
hacks/*/src/keyboard-visualizer

# Logs
*.log

# Resources
/resources/push-assets/*

# Local-only discovery / research notes (not shipped)
/discovery/

# Apple/Monotype-licensed font, loaded at runtime if present (see
# core/gfx/text/face.go's PUSHAPP_STYLED_FONT_DIR) — not redistributable
# in this public repo, so never track it even if a developer drops a copy
# in the expected assets/ path.
core/gfx/text/assets/*.otf
